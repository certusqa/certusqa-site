# local previews (not deployed)
preview-*.png
.DS_Store

# secrets — never commit.
# Any env file, not only the two named below: this repo is served from its root,
# so a committed .env.production would be both in git and publicly readable.
.env*
!.env.example
.env
.env.local

# private audit — never publish (repo is deployed to certusqa.com)
docs/AUDIT-*.md

# Cursor rules — keep locally, never deploy (this repo is served at certusqa.com)
.cursor/

# Agent context — keep locally, never deploy (same reason as .cursor/)
CLAUDE.md

# Unfinished legal drafts — never deploy
*.draft.html

# build output — assembled by scripts/build-dist.sh, never committed
dist/
