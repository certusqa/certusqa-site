# Legal pages: privacy.html / terms.html are served by Cloudflare Pages
# Pretty URLs at /privacy and /terms. Do NOT add /privacy → privacy.html
# rewrites here — they loop with the automatic .html → clean-URL 308.

# Dotfile guard. This repo is served in full at certusqa.com, so anything
# tracked in the root is public. These paths must never resolve, even if a
# dotfile is committed by accident or lingers in an edge cache.
/.cursor/*   /   301
/.git/*      /   301
/.env        /   301

# Repo furniture that the root-serving deploy (before 2026-09-06) published and
# that Cloudflare's edge cache kept serving with s-maxage=604800 after the
# allowlist build removed it. Same idea as the dotfile guard above: these
# paths must never resolve, whatever an edge cache still holds.
/README.md            /   301
/scripts/*            /   301
/.github/*            /   301
/CLAUDE.md            /   301
/notes/*              /   301
